# .env 模板：复制为 .env 后填写真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传 GitHub；每台机器（本地/云服务器）各自创建
# 密钥生成：openssl rand -hex 32

# 登录令牌签名密钥（必填，至少 32 位随机字符）
GOCHAT_JWT_SECRET=

# MySQL 初始化账号（docker-compose.yml 引用；仅 mysql 容器首次初始化时生效）
MYSQL_ROOT_PASSWORD=
MYSQL_USER=gochat
MYSQL_PASSWORD=
MYSQL_DATABASE=gochat

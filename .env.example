# .env 模板：复制为 .env 后填写真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传 GitHub；每台机器（本地/云服务器）各自创建
# 密钥生成：openssl rand -hex 32

# 登录令牌签名密钥（必填，至少 32 位随机字符）
GOCHAT_JWT_SECRET=

# Gateway 固定身份：每个应用实例使用唯一 node_id，并固定绑定一个 push partition。
# 扩容时复制一份实例配置，递增 partition；不要让两个实例消费同一个 partition。
GOCHAT_NODE_ID=node-1
GOCHAT_GATEWAY_PARTITION_ID=0

# Kafka topic / partition 规划。topic 由 make kafka-init 或 scripts/init-kafka.sh 创建。
GOCHAT_KAFKA_TOPIC_PREFIX=
GOCHAT_INBOX_PARTITIONS=3
GOCHAT_PUSH_PARTITIONS=3

# MySQL 初始化账号（docker-compose.yml 引用；仅 mysql 容器首次初始化时生效）
MYSQL_ROOT_PASSWORD=
MYSQL_USER=gochat
MYSQL_PASSWORD=
MYSQL_DATABASE=gochat
